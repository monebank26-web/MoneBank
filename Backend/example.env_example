DB_HOST={ip base de datos o del host}
DB_PORT={puerto base de datos}
DB_NAME={nombre base de datos}
DB_USER={nombre usuario de la base de datos}
DB_PASSWORD={contraseña de la base de datos}

POSTGRES_DB={nombre base de datos docker}
POSTGRES_USER={usuario de la base de datos de docker}
POSTGRES_PASSWORD={contraseña base de datos docker}

SECRET_KEY={llave base 256 para encriptacion de contraseña}