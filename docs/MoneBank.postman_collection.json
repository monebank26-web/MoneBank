  "item": [
    {
      "name": "General",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ""
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login de usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success) {",
                  "    pm.collectionVariables.set('token', json.token);",
                  "    pm.collectionVariables.set('id_usuario', String(json.usuario.id_usuario));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"bryan@gmail.com\",\n  \"contrasena\": \"1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "login"
              ]
            }
          }
        },
        {
          "name": "Registro de usuario",
